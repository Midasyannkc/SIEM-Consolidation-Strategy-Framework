#!/usr/bin/env python3
"""
SIEM Consolidation ROI Calculator
Quantifies financial benefits of SIEM consolidation
"""

import pandas as pd
import numpy as np
from datetime import datetime
import matplotlib.pyplot as plt

class ROICalculator:
    def __init__(self):
        self.current_costs = {}
        self.projected_costs = {}
        self.benefits = {}
    
    def calculate_license_savings(self, current_platforms, target_platform):
        """Calculate annual license cost savings"""
        current_total = sum([p['annual_cost'] for p in current_platforms])
        target_cost = target_platform['annual_cost']
        savings = current_total - target_cost
        
        return {
            'current_total': current_total,
            'target_cost': target_cost,
            'annual_savings': savings,
            'percentage_reduction': (savings / current_total) * 100
        }
    
    def calculate_operational_savings(self, analyst_hours_saved):
        """Calculate operational cost savings from efficiency gains"""
        avg_analyst_cost = 120000  # Annual salary + benefits
        hourly_rate = avg_analyst_cost / 2080  # Working hours per year
        
        annual_savings = analyst_hours_saved * hourly_rate
        
        return {
            'hours_saved_annually': analyst_hours_saved,
            'annual_savings': annual_savings,
            'monthly_savings': annual_savings / 12
        }
    
    def calculate_infrastructure_savings(self, current_infra, target_infra):
        """Calculate infrastructure cost reductions"""
        savings = {
            'hardware': current_infra['hardware'] - target_infra['hardware'],
            'cloud_costs': current_infra['cloud'] - target_infra['cloud'],
            'maintenance': current_infra['maintenance'] - target_infra['maintenance']
        }
        
        total_savings = sum(savings.values())
        return savings, total_savings
    
    def generate_roi_report(self, years=3):
        """Generate comprehensive ROI analysis"""
        total_investment = self.calculate_implementation_cost()
        annual_benefits = self.calculate_total_annual_benefits()
        
        roi_data = []
        cumulative_benefits = 0
        
        for year in range(1, years + 1):
            year_benefits = annual_benefits * year
            cumulative_benefits += annual_benefits
            net_benefit = cumulative_benefits - total_investment
            roi_percentage = (net_benefit / total_investment) * 100
            
            roi_data.append({
                'year': year,
                'cumulative_benefits': cumulative_benefits,
                'net_benefit': net_benefit,
                'roi_percentage': roi_percentage
            })
        
        return pd.DataFrame(roi_data)

# Example usage and calculations
roi_calc = ROICalculator()
roi_report = roi_calc.generate_roi_report()
